SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# PostgreSQL on Oracle or Supabase
DATABASE_URL=postgresql://fv_user:strong-password@127.0.0.1:5432/futurevision

# Optional: direct URL for migrations when using a pooled connection
DIRECT_URL=

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=replace-with-resend-api-key
DEFAULT_FROM_EMAIL=Future Vision <no-reply@your-domain.com>

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# Optional
SENTRY_DSN=
CORS_ALLOWED_ORIGINS=
DEFAULT_DAILY_TARGET=5
MAX_PROPERTY_IMAGE_MB=5
